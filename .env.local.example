# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend Email Configuration (optional - for email invitations)
# Get your API key from: https://resend.com/api-keys
# RESEND_API_KEY is server-side only (for sending emails)
# NEXT_PUBLIC_RESEND_FROM_EMAIL is client-side (for displaying "from" address)
RESEND_API_KEY=re_your_api_key_here
NEXT_PUBLIC_RESEND_FROM_EMAIL=onboarding@resend.dev
